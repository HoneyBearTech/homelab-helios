# The values behind the <<UPPER_SNAKE>> placeholders in kometa/config.yml: Kometa fills <<NAME>> from KOMETA_NAME.
# Copy to .env in Kometa's data directory, owned by the user Kometa runs as, and fill it in there:
#   sudo install -m 600 -o <PUID> -g <PGID> kometa.env.example <KOMETA_CONFIG_PATH>/.env   (values from .env)
# Kometa reads /config/.env itself when it starts, so the values never enter the container's environment
# (docker inspect doesn't show them). It is never committed. A placeholder left empty silently becomes empty.
#
# Plex's names are PLEX_SERVER_*, not PLEX_*: Kometa reads KOMETA_PLEX_URL and KOMETA_PLEX_TOKEN as its own
# settings and never fills a placeholder from them.

# Plex: the server's address as Kometa reaches it (e.g. http://plex:32400 on the stack's network) and its token.
KOMETA_PLEX_SERVER_URL=
KOMETA_PLEX_SERVER_TOKEN=

# API keys: TMDb (required), OMDb and MDBList (ratings).
KOMETA_TMDB_APIKEY=
KOMETA_OMDB_APIKEY=
KOMETA_MDBLIST_APIKEY=

# Tautulli: its address as Kometa reaches it (e.g. http://tautulli:8181) and its API key.
KOMETA_TAUTULLI_URL=
KOMETA_TAUTULLI_APIKEY=

# Where Kometa posts its run and error notices (one webhook URL for all of them).
KOMETA_NOTIFICATION_WEBHOOK=

# Radarr: the main instance (the default, and Kid's Movies) and the 4K instance (4k Movies). Address and API key.
KOMETA_RADARR_URL=
KOMETA_RADARR_TOKEN=
KOMETA_RADARR_4K_URL=
KOMETA_RADARR_4K_TOKEN=

# Sonarr: the main instance (the default, Anime and Kid's TV Shows) and the 4K instance (4k TV Shows).
KOMETA_SONARR_URL=
KOMETA_SONARR_TOKEN=
KOMETA_SONARR_4K_URL=
KOMETA_SONARR_4K_TOKEN=

# Radarr root folders as Radarr sees them (root_folder_path, also radarr_path), and the same folders as Plex sees
# them (plex_path): the default, Kid's Movies and 4k Movies.
KOMETA_RADARR_ROOT_FOLDER=
KOMETA_RADARR_PLEX_PATH=
KOMETA_KIDS_MOVIES_ROOT_FOLDER=
KOMETA_KIDS_MOVIES_PLEX_PATH=
KOMETA_MOVIES_4K_ROOT_FOLDER=
KOMETA_MOVIES_4K_PLEX_PATH=

# Sonarr root folders as Sonarr sees them (root_folder_path, also sonarr_path), and as Plex sees them
# (plex_path): the default, Anime, Kid's TV Shows and 4k TV Shows.
KOMETA_SONARR_ROOT_FOLDER=
KOMETA_SONARR_PLEX_PATH=
KOMETA_ANIME_ROOT_FOLDER=
KOMETA_ANIME_PLEX_PATH=
KOMETA_KIDS_TV_SHOWS_ROOT_FOLDER=
KOMETA_KIDS_TV_SHOWS_PLEX_PATH=
KOMETA_TV_SHOWS_4K_ROOT_FOLDER=
KOMETA_TV_SHOWS_4K_PLEX_PATH=
