# Runs scripts/scheduled-backup.sh once; started by homelab-helios-backup.timer. A systemd user unit: install it for
# the user who runs the stack (docs/installing.md#scheduled-backups). %h is that user's home directory: change
# both paths if the checkout lives elsewhere.
[Unit]
Description=Back up the homelab-helios stack and copy it off the host
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/homelab-helios
ExecStart=%h/homelab-helios/scripts/scheduled-backup.sh
# Runs at a low priority, so the services stay responsive while archives are compressed.
Nice=10
IOSchedulingClass=idle
