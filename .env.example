# Settings for one homelab-helios installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. Each service keeps its own logins, tokens and keys in its data directory. Plex's
# one-time claim token, the only secret a service takes from its environment, goes in a gitignored plex.env.

# On a host with an NVIDIA GPU (and the NVIDIA Container Toolkit), add compose.gpu.yaml so Plex transcodes on it.
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# The user and group Plex, Tautulli and Kometa run as. They must be able to read and write the media library and
# their own data directories.
PUID=1000
PGID=1000

# The media library Plex serves and AURA saves artwork into, mounted read-write. scripts/backup.sh never archives
# it, so protect it on the storage that holds it (snapshots).
MEDIA_PATH=/srv/media

# Plex's data: its database, metadata and settings (back it up before every upgrade, docs/upgrading.md), and its
# cache, which is disposable and never backed up.
PLEX_CONFIG_PATH=/srv/appdata/plex
PLEX_CACHE_PATH=/srv/plex-cache

# Scratch space for transcodes in progress, ideally on fast local disk; never backed up.
PLEX_TRANSCODE_PATH=/srv/plex-transcode

# Tautulli's database and settings: a host directory.
TAUTULLI_CONFIG_PATH=/srv/appdata/tautulli

# AURA's settings, including its Plex and MediUX tokens: a host directory. Kometa reads the artwork AURA keeps in
# its auraassets subdirectory.
AURA_CONFIG_PATH=/srv/appdata/aura

# Kometa's configuration (config.yml with its Plex token and API keys, collection and overlay files, assets, logs):
# a host directory. AURA writes artwork sets into its aura subdirectory.
KOMETA_CONFIG_PATH=/srv/appdata/kometa

# When Kometa runs each day (24-hour HH:MM, comma-separated for several runs).
KOMETA_TIMES=02:00

# ImageMaid's settings (with its Plex token): a host directory. ImageMaid also mounts Plex's data directory, to
# clean out images Plex no longer uses.
IMAGEMAID_CONFIG_PATH=/srv/appdata/imagemaid

# When ImageMaid runs, in its own schedule syntax (time|frequency, optionally |mode=..., comma-separated for
# several runs). Its other settings (Plex's address and token, the default mode) are in its data directory's .env.
IMAGEMAID_SCHEDULE=22:00|weekly(sunday)
