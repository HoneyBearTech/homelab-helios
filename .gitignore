# Settings and secrets for one installation; only the *.example templates are committed
.env
.env.*
!.env.example
*.env
!*.env.example
.envrc

# Service data and media never belong in the repo, even if a path setting points inside the checkout
appdata/
data/
media/
transcode/
# ...except the smoke test's empty placeholder directories (scripts/smoke-test.sh)
!tests/smoke/config-root/plex/transcode/

# Kometa's committed configuration is kometa/*.yml and nothing else. If kometa/ is ever Kometa's /config, what
# Kometa writes there (logs/, config.cache, config.yml.bak*, assets/, overlays/, reports, missing/) stays untracked
kometa/*
!kometa/*.yml

# Backups written by scripts/backup.sh: they hold the services' databases and logins
backups/

# The host's choice of GPU override, a symlink scripts/select-gpu.sh keeps (and its temporary name while it switches)
compose.host-gpu.yaml
compose.host-gpu.yaml.new

# Release and CI outputs (generated by the workflows, never committed)
compose.json
sbom.cdx.json
SHA256SUMS*
*.tar.gz
trivy.sarif

# Keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# The old in-repo vault path; project notes live in Chronos, never here
.obsidian-docs/

# Python tooling for scripts/ and tests/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
